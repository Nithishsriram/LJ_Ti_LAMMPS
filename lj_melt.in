units lj
atom_style atomic

lattice fcc 0.8442
region box block 0 10 0 10 0 10

create_box 1 box
create_atoms 1 box

mass 1 1.0

pair_style ljcut 2.5
pair_coeff 1 1 1.0 1.0 2.5

velocity all create 3.0 87287

neighbor 0.3 bin
neigh_modify every 20 delay 0 check yes

fix 1 all nve

compute msd_all all msd
fix msd_out all avetime 50 1 50 &
    c_msd_all[1] c_msd_all[2] c_msd_all[3] c_msd_all[4] &
    file msd.dat

# RDF
compute rdf_all all rdf 200
fix rdf_out all avetime 50 1 50 c_rdf_all[] &
    file rdf.dat mode vector

thermo 50
thermo_style custom step temp pe etotal press

run 1000